{
  "expo": {
    "name": "ifoodbankapp",
    "slug": "ifoodbankapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ifoodbankapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
      
    },
    "plugins": [
      "expo-router",
      
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
